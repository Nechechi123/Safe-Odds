# Django secret key — generate a strong random string for production
SECRET_KEY=change-me-to-a-long-random-string

# Set to True for local development, False in production
DEBUG=True

# Database connection string.
#   Local development: leave commented out to use SQLite (db.sqlite3).
#   Production: paste the Supabase "Session pooler" connection string and
#   replace [YOUR-PASSWORD] with your database password. The session pooler
#   (port 5432) is the one that works over IPv4 on Render.
# DATABASE_URL=postgresql://postgres.abcdefghijkl:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated trusted origins for CSRF (required for HTTPS admin on Render).
# On Render this is added automatically from RENDER_EXTERNAL_HOSTNAME, but you
# can set it explicitly for a custom domain.
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# SportyBet affiliate link
SPORTYBET_URL=https://www.sportybet.com

# Render only: pin the Python version used to build the app.
# PYTHON_VERSION=3.11.9
#
# Note: RENDER_EXTERNAL_HOSTNAME is provided automatically by Render and is
# added to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS by settings.py.
